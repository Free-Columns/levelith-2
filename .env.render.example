# ============================================
# Render Web Service Environment Variables
# ============================================
# Copy these values to your Render Dashboard:
# Settings -> Environment -> Add Environment Variable
#
# IMPORTANT: Do NOT commit a .env.render file with actual values!
# This is a template for reference only.
# ============================================

# ============================================
# Application Settings
# ============================================
APP_NAME=Levelith API
APP_VERSION=2.0.0
ENVIRONMENT=production
DEBUG=false

# ============================================
# Server Configuration
# ============================================
# Note: Render automatically sets PORT
# Do NOT set HOST or PORT manually in Render
HOST=0.0.0.0

# ============================================
# Database Configuration
# ============================================
# CRITICAL: This must be set in Render Dashboard
# Option 1: Use Render PostgreSQL (recommended)
#   - Create a PostgreSQL database in Render
#   - Link it to your web service
#   - Use the Internal Database URL
#
# Option 2: Use external PostgreSQL
#   - Provide the full connection string
#
# Format: postgresql://user:password@host:port/database
# Example: postgresql://levelith_user:password@dpg-xxxxx.oregon-postgres.render.com/levelith
DATABASE_URL=${DATABASE_URL}

# Database Connection Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# Security Settings
# ============================================
# CRITICAL: Generate a strong secret key
# Use: openssl rand -hex 32
# Or use Render's "Generate Value" feature
SECRET_KEY=${SECRET_KEY}

# JWT Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ============================================
# CORS Configuration
# ============================================
# Set this to your frontend URL(s)
# Multiple origins: separate with commas
# Example: https://levelith-frontend.onrender.com,https://levelith.com
CORS_ORIGINS=https://levelith-frontend.onrender.com

# ============================================
# API Configuration
# ============================================
API_V1_PREFIX=/api/v1

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Rate Limiting (Optional)
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# Redis Cache (Optional - not currently used)
# ============================================
# If you add Redis caching in the future
# REDIS_URL=redis://red-xxxxx.oregon-redis.render.com:6379
# REDIS_CACHE_TTL=300

# ============================================
# Python Version (Render Build Settings)
# ============================================
# Set this in Render Dashboard -> Environment
PYTHON_VERSION=3.11.0
