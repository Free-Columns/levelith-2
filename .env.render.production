# ============================================
# Render Web Service Environment Variables - PRODUCTION
# ============================================
# INSTRUCTIONS:
# 1. Go to Render Dashboard: https://dashboard.render.com
# 2. Select your web service: levelith-backend
# 3. Go to Environment tab
# 4. Add each variable below using "Add Environment Variable" button
# 5. DO NOT commit this file with actual credentials to Git!
# ============================================

# ============================================
# Application Settings
# ============================================
APP_NAME=Levelith API
APP_VERSION=2.0.0
ENVIRONMENT=production
DEBUG=false

# ============================================
# Server Configuration
# ============================================
# Note: Render automatically sets PORT - do NOT set it manually
HOST=0.0.0.0

# ============================================
# Database Configuration
# ============================================
# ACTUAL DATABASE URL - Set this in Render Dashboard
# This is your live PostgreSQL database on Render
DATABASE_URL=postgresql://levelith_user:8AwftjchMM2Y4ID1alOEmde3LUyJz5kM@dpg-d4df71ogjchc73duf8og-a.oregon-postgres.render.com/levelith

# Database Connection Pool Settings (optimized for Render free tier)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# Security Settings
# ============================================
# ACTUAL SECRET KEY - Use this exact value in Render Dashboard
SECRET_KEY=08a4ab222554f29ae4a0eb7d00482fa5a79f46f2617ed9cf6453347dc3a8461f

# JWT Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ============================================
# CORS Configuration
# ============================================
# Update this with your actual frontend URL when deployed
# For now, this allows the Render frontend (update when you deploy frontend)
CORS_ORIGINS=https://levelith-frontend.onrender.com,https://levlith.online

# ============================================
# API Configuration
# ============================================
API_V1_PREFIX=/api/v1

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# IMPORTANT NOTES:
# ============================================
# 1. If the database URL doesn't work, check your Render PostgreSQL dashboard
#    for the correct "Internal Database URL" (should end with .render.com)
# 2. After adding all environment variables, click "Save Changes"
# 3. Render will automatically redeploy your service
# 4. Test the connection using: curl https://your-service.onrender.com/health
# ============================================
